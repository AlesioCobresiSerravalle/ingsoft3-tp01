# Plantilla de nginx: la imagen oficial de nginx le aplica `envsubst` al
# arrancar (todo archivo de /etc/nginx/templates/*.template se convierte en
# /etc/nginx/conf.d/<nombre sin .template>). Así la MISMA imagen sirve en
# compose, en QA y en PROD: lo que cambia es la configuración, no el build.
#   BACKEND_URL  = a dónde reenviar /api   (default en el Dockerfile: http://backend:3000)
#   DNS_RESOLVER = quién resuelve ese nombre (default: el DNS interno de Docker)
server {
    listen 80;

    # SPA: estáticos, con fallback a index.html para las rutas del router
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # El destino va en una variable y no directo en proxy_pass: con el nombre
    # directo nginx lo resuelve AL ARRANCAR y, si el backend todavía no existe,
    # se niega a levantar. Con variable resuelve cuando llega un pedido (y por
    # eso hace falta `resolver`).
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $backend_api ${BACKEND_URL};

    location /api/ {
        # Si BACKEND_URL es https (un servicio público de la nube), nginx
        # necesita mandar el nombre en el handshake TLS y el Host correcto.
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_pass $backend_api;
    }
}
